{
  "expo": {
    "name": "Conn",
    "slug": "conn",
    "version": "0.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "conn",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Conn uses photos you choose so you can send them in a chat.",
          "cameraPermission": "Conn uses the camera so you can take a photo and send it in a chat.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.conn.app"
    },
    "android": {
      "package": "dev.conn.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
